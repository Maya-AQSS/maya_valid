meta {
  name: Error - JSON Body Not an Object
  type: http
  seq: 12
}

post {
  url: {{odooURLInternal}}/api/v1/validations/studies/sync
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  ["claim"]
}

assert {
  res.status: eq 400
  res.body.success: eq false
  res.body.code: eq INVALID_JSON
}

tests {
  test("Debe devolver 400 si el cuerpo no es un objeto JSON", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("INVALID_JSON");
  });
}
