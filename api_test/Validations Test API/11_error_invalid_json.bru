meta {
  name: Error - Invalid JSON Body
  type: http
  seq: 11
}

post {
  url: {{odooURLInternal}}/api/v1/validations/studies/sync
  body: text
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{apiKey}}
}

body:text {
  { "kind": "claim",
}

assert {
  res.status: eq 400
  res.body.success: eq false
  res.body.code: eq INVALID_JSON
}

tests {
  test("Debe devolver 400 si el JSON está mal formado", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("INVALID_JSON");
  });
}
