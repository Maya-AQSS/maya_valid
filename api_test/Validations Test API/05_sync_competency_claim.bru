meta {
  name: Sync Competency Claims - Success
  type: http
  seq: 5
}

post {
  url: {{odooURLInternal}}/api/v1/validations/competency/sync
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "kind": "claim"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.type: eq competency
  res.body.kind: eq claim
}

tests {
  test("Sincroniza las reclamaciones de convalidación por competencias", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.tasks).to.be.an("array");
    expect(body.totals).to.be.an("object");
  });

  test("Cada tarea trae sus recuentos o un error", function() {
    for (const task of res.getBody().tasks) {
      expect(task).to.have.property("task_id");
      if (!task.error) {
        expect(task).to.have.property("received");
      }
    }
  });
}
