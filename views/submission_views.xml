<odoo>
  <data>

    <!-- amplía las vistas de maya_moodle.submission con los campos de convalidaciones -->

    <record model="ir.ui.view" id="maya_valid.submission_list_inherit">
      <field name="name">Entregas de convalidaciones en Moodle</field>
      <field name="model">maya_moodle.submission</field>
      <field name="inherit_id" ref="maya_moodle.submission_list"/>
      <field name="arch" type="xml">
        <field name="task_key" position="after">
          <field name="kind" optional="show"/>
        </field>
      </field>
    </record>

    <record model="ir.ui.view" id="maya_valid.submission_form_inherit">
      <field name="name">Entrega de convalidaciones en Moodle</field>
      <field name="model">maya_moodle.submission</field>
      <field name="inherit_id" ref="maya_moodle.submission_form"/>
      <field name="arch" type="xml">
        <field name="school_year_id" position="after">
          <field name="kind" invisible="not kind"/>
        </field>
        <group name="submission" position="after">
          <group string="Ficheros descargados" invisible="not kind">
            <field name="zip_path"/>
            <field name="folder_path"/>
          </group>
        </group>
      </field>
    </record>

    <record model="ir.ui.view" id="maya_valid.submission_search_inherit">
      <field name="name">Búsqueda de entregas de convalidaciones</field>
      <field name="model">maya_moodle.submission</field>
      <field name="inherit_id" ref="maya_moodle.submission_search"/>
      <field name="arch" type="xml">
        <separator name="filters_extra" position="after">
          <filter name="filter_studies" string="Convalidación por estudios" domain="[('kind', '!=', False), ('validation_type', '=', 0)]"/>
          <filter name="filter_competency" string="Convalidación por competencias" domain="[('kind', '!=', False), ('validation_type', '=', 1)]"/>
        </separator>
        <filter name="group_by_task" position="after">
          <filter name="group_by_kind" string="Entrega" context="{'group_by': 'kind'}"/>
        </filter>
      </field>
    </record>

    <!-- sólo las entregas de las tareas de convalidaciones -->
    <record model="ir.actions.act_window" id="maya_valid.action_submissions">
      <field name="name">Entregas en Moodle</field>
      <field name="res_model">maya_moodle.submission</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('kind', '!=', False)]</field>
      <field name="context">{'search_default_group_by_study': 1}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">Todavía no se han sincronizado entregas desde Moodle</p>
      </field>
    </record>

    <menuitem name="Entregas en Moodle" id="maya_valid.menu_submissions" parent="maya_valid.menu_configuration"
              action="maya_valid.action_submissions" groups="maya_core.group_ROOT,maya_core.group_MNGT"/>

  </data>
</odoo>
