<odoo>
  <data>
    <record id="action_config_settings_maya_valid" model="ir.actions.act_window">
      <field name="name">Ajustes de Maya | Valid</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">res.config.settings</field>
      <field name="view_mode">form</field>
      <field name="target">current</field>
      <field name="context">{'module' : 'maya_valid', 'bin_size': False}</field>
    </record>

    <record model="ir.ui.view" id="res_config_settings_view_form_maya_valid">
      <field name="name">Configuración Maya | Valid</field>
      <field name="model">res.config.settings</field>
      
      <!-- hereda de la vista base de configuraciones --> 
      <field name="inherit_id" ref="base.res_config_settings_view_form" /> 
      <field name="arch" type="xml">
      
        <xpath expr="//app[@name='maya_core']" position="after">
          <!-- string, el texto que aparecerá en el menu lateral-->
          <app data-string="Maya | Valid" string="Maya | Valid" name="maya_valid">
            <h2>Convalidaciones</h2>
            <div class="row mt16 o_settings_container" name="maya_validations_setting_container">
              <div class="col-12 col-lg-6 o_setting_box" title="Carpeta convalidaciones">
                <div class="o_setting_right_pane">
                 <span class="o_form_label">Carpeta</span>
                 <div class="text-muted">Ruta de almacenamiento de convalidaciones</div>
                 <div class="text-muted content-group mt8" style="width: 100% !important">
                   <field name="validations_path" />
                 </div>
                </div>
              </div>
            </div>
          </app>
        </xpath>
      </field>
    </record>  
  </data>
</odoo>